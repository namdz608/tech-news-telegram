NODE_ENV=development
PORT=3000

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRANSLATION_TARGET_LANGUAGE=vi

MAX_ARTICLES_PER_DIGEST=20
MAX_JOBS_PER_DIGEST=10
REQUEST_TIMEOUT_MS=12000
USER_AGENT=TechNewsTelegramBot/1.0

# Optional: FlareSolverr endpoint to fetch TopCV through Cloudflare
# Example: http://127.0.0.1:8191/v1
FLARESOLVERR_URL=

# SMTP — gửi PDF tin tuyển dụng (POST /telegram/send-jobs)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Editorial providers: openai, codex, google, none
EDITORIAL_PROVIDER=google
CODEX_TRANSLATION_TIMEOUT_MS=60000
MAX_ARTICLES_PER_TOPIC=2
GITHUB_TOKEN=
